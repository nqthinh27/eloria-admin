# Tên ứng dụng — hiển thị ở logo, tiêu đề trang
VITE_APP_NAME=Eloria Admin

# Base path khi deploy vào thư mục con. Để trống nếu deploy ở root.
VITE_BASE_URL=

# Dùng HashRouter thay vì BrowserRouter (chỉ cần khi host tĩnh không rewrite được URL)
VITE_USE_HASH_ROUTE=false

# Base URL của API.
# BẮT BUỘC để đường dẫn tương đối (same-origin) — cookie refresh_token của backend là HttpOnly,
# không Secure, không SameSite nên chỉ hoạt động khi cùng origin. Dev đi qua proxy của Vite
# (xem `server.proxy` trong vite.config.ts). Xem CONVENTIONS mục 2.
VITE_API_BASE_URL=/v1.0/api

# Đích proxy của Vite khi chạy dev — địa chỉ backend Spring Boot.
VITE_API_PROXY_TARGET=http://localhost:8080

# Bật dữ liệu mock cho các module backend chưa có API (PLAN Phase 6).
VITE_USE_MOCK=true
